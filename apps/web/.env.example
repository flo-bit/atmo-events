# Generate both with: pnpm env:setup-dev
CLIENT_ASSERTION_KEY=
COOKIE_SECRET=

# Set to your tunnel URL to use a confidential client in dev
# OAUTH_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# atproto network (optional). Every address atmo uses on the atproto network,
# each named after its service. Unset, each is the public network's address,
# so the app runs as before. Set them to point atmo at a local test network or
# a sandbox. PUBLIC_ means the browser reads the setting too. See src/env.ts.
# PUBLIC_PLC_URL=https://plc.example.com
# PUBLIC_DOH_URL=https://dns.example.com/dns-query
# PUBLIC_SLINGSHOT_URL=https://slingshot.example.com
# PUBLIC_CONSTELLATION_URL=https://constellation.example.com
# Bluesky API, for comments and handle search:
# PUBLIC_APPVIEW_URL=https://appview.example.com
# Image CDN, serving /img/<preset>/plain/<did>/<cid>@<format>:
# PUBLIC_CDN_URL=https://cdn.example.com
# PUBLIC_JETSTREAM_URL=wss://jetstream.example.com
# Relays take a comma-separated list:
# PUBLIC_RELAY_URLS=https://relay.example.com
# Where the sign-up button creates accounts:
# PUBLIC_SIGNUP_PDS_URL=https://pds.example.com

# Official moderator: @atmo.rsvp. Use stable DIDs, not handles.
# Keep in sync with Wrangler vars; CLI commands use this env.
# Override locally for testing, or leave empty to grant nobody moderator access.
MODERATOR_DIDS=did:plc:b63bmauox6z5rbibwrhxrdnw

# Optional interactive event address entry/maps. No external search index or drip.
# GEOCODER_URL=https://us1.locationiq.com/v1/search
# GEOCODER_KEY=
# GEOCODER_USER_AGENT=atmo-events (you@example.com)
