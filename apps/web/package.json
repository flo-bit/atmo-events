{
	"name": "web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-worker.mjs",
		"generate": "contrail-lex generate",
		"generate:favicons": "node scripts/generate-favicons.mjs",
		"generate:og": "tsx scripts/generate-og.ts",
		"generate:globe": "tsx scripts/bake-globe.ts",
		"test:favicons": "node --test scripts/test-favicons.mjs",
		"test:country-ssr": "node --test scripts/test-country-ssr.mjs",
		"generate:pull": "contrail-lex all",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"backfill": "contrail backfill",
		"backfill:remote": "contrail backfill --remote",
		"meili:reindex": "npx tsx src/lib/search/server/reindex-cli.ts",
		"meili:reindex:remote": "npx tsx src/lib/search/server/reindex-cli.ts --remote",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test scripts/test-build-worker.mjs && vitest run",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"env:generate-key": "atproto-oauth keygen",
		"env:generate-secret": "atproto-oauth secret",
		"env:setup-dev": "atproto-oauth setup",
		"tunnel": "cloudflared tunnel --url http://127.0.0.1:5454",
		"publish-lexicons": "contrail-lex publish",
		"seed:conference": "bun run scripts/publish-test-conference.ts",
		"geocode:backfill": "tsx scripts/geocode-events.ts"
	},
	"devDependencies": {
		"@atcute/atproto": "^4.0.4",
		"@atcute/bluesky": "^4.0.25",
		"@atcute/client": "^5.1.2",
		"@atcute/identity-resolver": "^2.0.3",
		"@atcute/lex-cli": "^3.3.0",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/oauth-node-client": "^2.0.1",
		"@atcute/tid": "^1.1.4",
		"@atmo-dev/contrail-appview": "0.12.2",
		"@atmo-dev/contrail-lexicons": "^0.4.15",
		"@cloudflare/workers-types": "^5.20261026.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-geo": "^3.1.1",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"bits-ui": "^2.20.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"unwasm": "0.6.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wrangler": "^4.153.0"
	},
	"license": "MIT",
	"dependencies": {
		"@atcute/bluesky-richtext-parser": "^2.1.2",
		"@atcute/jetstream": "^2.2.0",
		"@atcute/password-session": "^1.0.2",
		"@atmo-dev/contrail": "^0.12.2",
		"@atmo-dev/events-ui": "workspace:*",
		"@atmo-dev/kit": "0.1.0",
		"@internationalized/date": "^3.12.4",
		"@number-flow/svelte": "^0.4.2",
		"@sketchyicons/svelte": "^0.5.0",
		"@svelte-atproto/oauth": "^0.4.1",
		"@tailwindcss/typography": "^0.5.20",
		"@takumi-rs/helpers": "2.18.2",
		"@takumi-rs/wasm": "2.18.2",
		"d3-geo": "^3.1.1",
		"dompurify": "^3.4.17",
		"h3-js": "^4.5.0",
		"hls.js": "^1.7.3",
		"i18n-iso-countries": "^7.14.0",
		"maplibre-gl": "^6.16.0",
		"marked": "^18.1.2",
		"mode-watcher": "^1.1.0",
		"plyr": "^3.8.5",
		"svelte-boring-avatars": "^1.2.6",
		"svelte-maplibre-gl": "^2.2.1",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
