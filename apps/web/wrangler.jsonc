{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmo-events",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-12-25",
	"compatibility_flags": ["nodejs_compat_v2"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"OAUTH_PUBLIC_URL": "https://atmo.rsvp",
		// Explicit production pilot opt-in. Set false (or remove) to restore the
		// baseline RSVP surface; the kill switch also disables the pilot policy.
		"ATM_TICKET_DISCOVERY_ENABLED": "true",
		"ATM_TICKET_APPVIEW_URL": "https://appview.atmosphere.money",
		// Temporary explicit policy for the ticketing pilot. ticketedEvent discovery alone
		// does not imply admission is required.
		"ATM_TICKET_REQUIRED_EVENT_URIS": "at://did:plc:retm6aeqattyxp7bhmyyv7gk/community.lexicon.calendar.event/3mrdbziccpcah",
		// Reply bot. BOT_APP_PASSWORD is a secret: `wrangler secret put BOT_APP_PASSWORD`.
		"BOT_IDENTIFIER": "going.atmo.rsvp",
		"BOT_PDS_URL": "https://eurosky.social"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atmo-events-v5",
			"database_id": "3f862040-84ee-4216-8ba7-ef3146058de4"
		}
	],
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_SESSIONS",
			"id": "3922ab84a8bb4fecb46526e3577a0665"
		},
		{
			"binding": "OAUTH_STATES",
			"id": "46cfb5c0bb8c41378e757b46afd7dd35"
		}
	]
}
