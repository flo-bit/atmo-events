{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atmo-events",
	// The adapter generates this file; build-worker.mjs wraps its default export with cron.
	// Keep both Worker modules outside the public assets directory.
	"main": ".svelte-kit/worker.js",
	"compatibility_date": "2025-12-25",
	"compatibility_flags": ["nodejs_compat_v2"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1
		}
	},
	"vars": {
		"OAUTH_PUBLIC_URL": "https://atmo.rsvp",
		// Set trusted moderator DIDs before enabling moderator access.
		"MODERATOR_DIDS": "",
		// Reply bot. BOT_APP_PASSWORD is a secret: `wrangler secret put BOT_APP_PASSWORD`.
		"BOT_IDENTIFIER": "going.atmo.rsvp",
		"BOT_PDS_URL": "https://eurosky.social",
		"OG_DAILY_GENERATION_LIMIT": "300",
		"OG_CYCLE_GENERATION_LIMIT": "3000",
		"OG_BILLING_CYCLE_START_DAY": "13"
	},
	"d1_databases": [
		{
			"binding": "DB",
			// Backfilled candidate; the old production DB is retained for rollback.
			"database_name": "atmo-events-records-g20261028",
			"database_id": "2e4b6ea4-6c67-444a-b37d-73594c5b2c01"
		},
		{
			"binding": "REPORTS_DB",
			"database_name": "atmo-events-reports",
			// Stable private storage; never replace during projection rebuilds.
			"database_id": "451dce30-46b2-4e2d-a09c-f7ed4ccdfc4c"
		}
	],
	"r2_buckets": [
		{
			"binding": "OG_IMAGES",
			"bucket_name": "atmo-events-og-images"
		}
	],
	"ratelimits": [
		{
			"name": "STARTER_PACK_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["*/1 * * * *"]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_SESSIONS",
			"id": "3922ab84a8bb4fecb46526e3577a0665"
		},
		{
			"binding": "OAUTH_STATES",
			"id": "46cfb5c0bb8c41378e757b46afd7dd35"
		}
	]
}
