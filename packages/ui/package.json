{
	"name": "@atmo-dev/events-ui",
	"version": "0.1.0",
	"description": "Svelte components for atmo events (EventView, EventEditor, EventCard).",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/flo-bit/atmo-events.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/flo-bit/atmo-events/tree/main/packages/ui#readme",
	"bugs": "https://github.com/flo-bit/atmo-events/issues",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"package": "svelte-package -i src -o dist && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"prepublishOnly": "pnpm package"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"svelte": "./dist/index.js",
	"peerDependencies": {
		"@atmo-dev/kit": "^0.2.1",
		"@sketchyicons/svelte": "^0.5.0",
		"bits-ui": "^2.16.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		},
		"svelte-maplibre-gl": {
			"optional": true
		},
		"hls.js": {
			"optional": true
		},
		"plyr": {
			"optional": true
		}
	},
	"dependencies": {
		"@atcute/bluesky-richtext-parser": "^2.1.2",
		"@atcute/tid": "^1.1.4",
		"@internationalized/date": "^3.12.4",
		"@number-flow/svelte": "^0.4.2",
		"dompurify": "^3.4.17",
		"esm-env": "^1.2.2",
		"h3-js": "^4.5.0",
		"i18n-iso-countries": "^7.14.0",
		"marked": "^18.1.2",
		"svelte-boring-avatars": "^1.2.6",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@atmo-dev/kit": "^0.2.1",
		"@sketchyicons/svelte": "^0.5.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@vitest/browser-playwright": "^5.0.5",
		"axe-core": "^4.14.0",
		"bits-ui": "^2.20.2",
		"hls.js": "^1.7.3",
		"maplibre-gl": "^6.16.0",
		"playwright": "^1.64.1",
		"plyr": "^3.8.5",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-maplibre-gl": "^2.2.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	}
