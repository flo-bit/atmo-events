{
	"name": "atmo-rsvp",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"kit:local": "node scripts/kit-dev.mjs local",
		"kit:registry": "node scripts/kit-dev.mjs registry",
		"test:kit-dev": "node --test scripts/kit-dev.test.mjs",
		"build": "pnpm --filter web build",
		"generate:favicons": "pnpm --filter web generate:favicons",
		"generate:og": "pnpm --filter web generate:og",
		"check": "pnpm -r check",
		"test": "pnpm test:kit-dev && pnpm -r test",
		"lint": "pnpm -r lint",
		"test:e2e": "snowglobe up && snowglobe run --app e2e -- pnpm --filter web exec vitest run --config vitest.e2e.config.ts",
		"e2e:dev": "snowglobe up && snowglobe run --app atmo -- pnpm --filter web dev --strictPort",
		"e2e:backfill": "snowglobe up && snowglobe run --app atmo -- pnpm --filter web backfill:local",
		"e2e:down": "snowglobe down",
		"format": "prettier --write ."
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.17.0"
	},
	"devDependencies": {
		"@openmeet/snowglobe": "^0.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
