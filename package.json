{
	"name": "atmo-events-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.2.2",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"kit:local": "node scripts/kit-dev.mjs local",
		"kit:registry": "node scripts/kit-dev.mjs registry",
		"test:kit-dev": "node --test scripts/kit-dev.test.mjs",
		"build": "pnpm --filter web build",
		"generate:favicons": "pnpm --filter web generate:favicons",
		"generate:og": "pnpm --filter web generate:og",
		"check": "pnpm -r check",
		"test": "pnpm test:kit-dev && pnpm -r test",
		"lint": "pnpm -r lint",
		"format": "prettier --write .",
		"package:ui": "pnpm --filter @atmo-dev/events-ui package",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm install --lockfile-only",
		"release": "changeset publish"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22.17.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
